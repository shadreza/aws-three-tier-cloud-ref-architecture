# Copy this file to .env to change local settings. Every value is optional.

# Change a port if something else on your machine already uses it.
WEB_PORT=5173
API_PORT=8080
MYSQL_PORT=3306

# Token needed to add or delete monitors.
ADMIN_TOKEN=local-dev-token

# How often the local scheduler runs each job.
DEV_CHECK_EVERY=1m
DEV_ROLLUP_EVERY=5m
